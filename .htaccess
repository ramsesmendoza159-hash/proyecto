RewriteRule ^tecnico/mis_equipos$ index.php?controller=tecnico&action=mis_equipos [QSA,L]
RewriteRule ^tecnico/equipo_detalle/([0-9]+)$ index.php?controller=tecnico&action=equipo_detalle&id=$1 [QSA,L]
RewriteRule ^tecnico/herramientas$ index.php?controller=tecnico&action=herramientas [QSA,L]
RewriteRule ^tecnico/dashboardData$ index.php?controller=tecnico&action=dashboardData [QSA,L]

# ==========================================
# SUPERVISOR
# ==========================================
RewriteRule ^supervisor$ index.php?controller=supervisor&action=index [QSA,L]
RewriteRule ^supervisor/dashboardData$ index.php?controller=supervisor&action=dashboardData [QSA,L]
RewriteRule ^supervisor/ordenes$ index.php?controller=supervisor&action=ordenes [QSA,L]
RewriteRule ^supervisor/ordenesList$ index.php?controller=supervisor&action=ordenesList [QSA,L]
RewriteRule ^supervisor/revisar/([0-9]+)$ index.php?controller=supervisor&action=revisar&id=$1 [QSA,L]
RewriteRule ^supervisor/guardar_revision$ index.php?controller=supervisor&action=guardar_revision [QSA,L]
RewriteRule ^supervisor/supervisiones$ index.php?controller=supervisor&action=supervisiones [QSA,L]
RewriteRule ^supervisor/supervisionesList$ index.php?controller=supervisor&action=supervisionesList [QSA,L]
RewriteRule ^supervisor/ver_orden/([0-9]+)$ index.php?controller=supervisor&action=ver_orden&id=$1 [QSA,L]
RewriteRule ^supervisor/ver_supervision/([0-9]+)$ index.php?controller=supervisor&action=ver_supervision&id=$1 [QSA,L]
RewriteRule ^supervisor/tecnicosList$ index.php?controller=supervisor&action=tecnicosList [QSA,L]

# ==========================================
# FALLBACK (SIEMPRE AL FINAL)
# ==========================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]