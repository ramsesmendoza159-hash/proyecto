# .htaccess - Configuración de Apache para el proyecto
# Ubicación: C:\xampp\htdocs\proyecto\.htaccess
# VERSIÓN CORREGIDA
# ✅ FIX: eliminada regla duplicada de /checklists/ver/{id}
#         (queda solo la que apunta a checklistEjecucion)

RewriteEngine On
RewriteBase /proyecto/

# ==========================================
# PREVENIR LISTADO DE DIRECTORIOS
# ==========================================
Options -Indexes

# ==========================================
# BLOQUEAR ARCHIVOS SENSIBLES
# ==========================================
<FilesMatch "\.(env|log|sql|md|lock|bak|old|swp|ini|conf|yml|yaml|dist|example)$">
    Require all denied
</FilesMatch>

# ==========================================
# BLOQUEAR ACCESO A CARPETAS INTERNAS
# ==========================================
RewriteRule ^(config|model|controller|helpers|logs|\.git|\.env|vendor|node_modules)(/|$) - [F,L]

# ==========================================
# BLOQUEAR ACCESO A .htaccess y .git
# ==========================================
<FilesMatch "^\.(htaccess|htpasswd|git|env)">
    Require all denied
</FilesMatch>

# ==========================================
# BLOQUEAR PHP EN CARPETA UPLOADS
# ==========================================
RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phps|pht|phar)$ - [F,L]

# ==========================================
# PERMITIR ARCHIVOS ESTÁTICOS
# ==========================================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|pdf|webp)$ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==========================================
# AUTENTICACIÓN
# ==========================================
RewriteRule ^login$ index.php?controller=auth&action=login [QSA,L]
RewriteRule ^auth/login$ index.php?controller=auth&action=login [QSA,L]
RewriteRule ^auth/authenticate$ index.php?controller=auth&action=authenticate [QSA,L]
RewriteRule ^logout$ index.php?controller=auth&action=logout [QSA,L]
RewriteRule ^auth/logout$ index.php?controller=auth&action=logout [QSA,L]

# ==========================================
# DASHBOARD
# ==========================================
RewriteRule ^dashboard$ index.php?controller=dashboard&action=index [QSA,L]

